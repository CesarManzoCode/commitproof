# CommitProof nemesis helper image (CONTRACT §5.1 nem-*, §8; ADR-0005):
# alpine with iptables and iproute2, plus cpnet (CommitProof's probe tool).
# CommitProof-owned (not derived from upstream). One helper joins each
# network namespace of the topology with capability NET_ADMIN only. Built by
# `commitproof images build` with the repository root as context.
FROM golang:1.26.9-alpine@sha256:3082400e369fa24d5fc60bca20edab3f6d604e0c5a690ec66b295eff4dd87ade AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/cpnet ./cmd/cpnet

FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
# Alpine packages from the pinned base's own repository (versions are
# recorded in images.lock.json, like pgBackRest's in upstream images).
RUN apk add --no-cache iptables iproute2 \
 && iptables --version && tc -V
COPY --from=builder /out/cpnet /usr/local/bin/cpnet
ENTRYPOINT ["/usr/local/bin/cpnet"]
CMD ["idle"]
