# CommitProof — all entry points are make targets (CONTRACT §13).
SHELL := /bin/bash
.SHELLFLAGS := -eu -o pipefail -c

# ADR-0014 / ADR-0019: any host Go >= 1.21 downloads and uses exactly go1.26.9.
export GOTOOLCHAIN := go1.26.9
export CGO_ENABLED := 0

EVIDENCE_K1 := evidence/K1
BIN := bin
PKG := github.com/CesarManzoCode/commitproof

# Source identity linked into the binaries (internal/buildinfo). Dirty means
# uncommitted changes outside evidence/ and images.lock.json.
CP_COMMIT := $(shell git rev-parse HEAD 2>/dev/null || echo unknown)
CP_DIRTY := $(shell test -z "$$(git status --porcelain -- . ':(exclude)evidence' ':(exclude)images.lock.json' 2>/dev/null)" && echo false || echo true)
LDFLAGS := -X $(PKG)/internal/buildinfo.Commit=$(CP_COMMIT) -X $(PKG)/internal/buildinfo.Dirty=$(CP_DIRTY)

.PHONY: prereq-check build ci-unit ci-checkers ci-cluster-smoke ci-nemesis-smoke ci-mutant-smoke ci-report sabotage-nemesis check-dockerfile-derivation lint-workflow tidy elle-oracle corpus campaign-k7 campaign-k7-status

## prereq-check: verify docs/PREREQUISITES.md; writes evidence/K1/prereq.json; exit 3 on any FAIL
prereq-check:
	@scripts/prereq-check.sh $(EVIDENCE_K1)/prereq.json

## build: commitproof, cpcheck, cpgate, cpreport, quorumxcheck into bin/
build:
	go build -trimpath -ldflags "$(LDFLAGS)" -o $(BIN)/ ./cmd/commitproof ./cmd/cpcheck ./cmd/cpgate ./cmd/cpreport ./cmd/quorumxcheck

## ci-unit: gofmt, go vet, staticcheck (tools/go.mod), unit tests incl. the
## independence (§5.3) and parameters-table (§5.7) tests
ci-unit:
	@test -z "$$(gofmt -l cmd internal)" || { echo "gofmt needed:"; gofmt -l cmd internal; exit 1; }
	go vet ./...
	go tool -modfile=tools/go.mod staticcheck ./...
	go test -count=1 ./...

## ci-checkers: K2 corpus regenerated byte for byte and classified as
## planted, Elle oracle differential, checker sabotage controls, UNKNOWN
## control (CONTRACT §13, §15 K2); needs Docker for the oracle image
ci-checkers: build elle-oracle
	scripts/ci-checkers.sh

## elle-oracle: build commitproof/elle-oracle from elle-cli's pinned commit in the pinned clojure image
elle-oracle:
	scripts/elle-oracle.sh

## corpus: regenerate testdata/corpus, testdata/pathological, testdata/corpus-k5 and testdata/corpus-k7 (internal/synth)
corpus:
	go run ./internal/tools/gencorpus --out testdata
	go run ./internal/tools/gencorpus --set k5 --out testdata
	go run ./internal/tools/gencorpus --set k7 --out testdata

## ci-cluster-smoke: build pinned images, cluster up/verify/down, 45 s smoke run, cpcheck verify-seal
ci-cluster-smoke: build
	scripts/ci-cluster-smoke.sh

## ci-nemesis-smoke: one 45 s run per fault kind F1a, F2a, F3a, F7 (F4a
## when /dev/fuse exists, else a SKIPPED-WITH-REASON line), cpcheck on each
ci-nemesis-smoke: build
	scripts/ci-nemesis-smoke.sh

## ci-mutant-smoke: build mutant M1, run its directed schedule D1 once,
## require cpcheck FAIL with C1 lost-write (CONTRACT §13)
ci-mutant-smoke: build
	scripts/ci-mutant-smoke.sh

## ci-report: render the committed K6 reference run and compare the bytes
## with the committed example report, without normalization (CONTRACT §13,
## §15 K6)
ci-report: build
	scripts/ci-report.sh

## campaign-k7: K7's matrix (campaigns/k7.json; ADR-0039–ADR-0041), local
## only (CONTRACT §13): `commitproof campaign` detached from the terminal,
## log $(K7_OUT)/campaign-k7.log; resumable — re-invoke to continue (sealed
## runs are never recomputed). DRY_RUN=1 prints each cell's plan and the
## run count and starts nothing. K7_MATRIX / K7_OUT override the matrix and
## the output directory.
K7_MATRIX ?= campaigns/k7.json
K7_OUT ?= runs/k7
campaign-k7: build
	scripts/campaign-k7.sh $(if $(filter 1,$(DRY_RUN)),dry-run,start) $(K7_MATRIX) $(K7_OUT)

## campaign-k7-status: whether make campaign-k7 is running, and the runs
## made and still to make in $(K7_OUT)
campaign-k7-status: build
	scripts/campaign-k7.sh status $(K7_MATRIX) $(K7_OUT)

## sabotage-nemesis: K3.2/K3.3 fixtures — host binaries and runner images
## built with each cp_sabotage_inject_<kind> / cp_sabotage_heal_<kind> tag
sabotage-nemesis:
	scripts/sabotage-nemesis.sh

## check-dockerfile-derivation: build/Dockerfile* differ from upstream only in FROM lines (K1.3)
## (DERIVATION_OUT=<dir> also writes the evidence copies)
check-dockerfile-derivation:
	go run ./internal/tools/derivcheck $(if $(DERIVATION_OUT),--out $(DERIVATION_OUT))

## lint-workflow: actionlint (pinned image, CONTRACT §14) on .github/workflows
ACTIONLINT := rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667
lint-workflow:
	timeout 300 docker run --rm --network none -v ./:/repo:ro -w /repo $(ACTIONLINT) -verbose

## tidy: go mod tidy for both modules
tidy:
	go mod tidy
	cd tools && go mod tidy
