{"argv":["bash","-c","#!/usr/bin/env bash\n# Removes only resources labelled com.docker.compose.project=commitproof (AGENTS.md §5); images kept.\nset -u -o pipefail\nL=label=com.docker.compose.project=commitproof\nc=$(docker ps -aq --filter \"$L\"); echo \"containers: $(echo $c | wc -w)\"\n[ -n \"$c\" ] && timeout 120 docker rm -f $c >/dev/null\nn=$(docker network ls -q --filter \"$L\"); echo \"networks: $(docker network ls --filter \"$L\" --format '{{.Name}}' | tr '\\n' ' ')\"\n[ -n \"$n\" ] && timeout 60 docker network rm $n >/dev/null\nv=$(docker volume ls -q --filter \"$L\"); echo \"volumes: $(echo $v | tr '\\n' ' ')\"\n[ -n \"$v\" ] && timeout 60 docker volume rm $v >/dev/null\necho \"left: containers=$(docker ps -aq --filter \"$L\" | wc -l) networks=$(docker network ls -q --filter \"$L\" | wc -l) volumes=$(docker volume ls -q --filter \"$L\" | wc -l)\""],"end":"2026-10-16T17:00:47.290Z","exit_code":0,"name":"docker-cleanup-resume","start":"2026-10-16T17:00:46.808Z","stderr":"evidence/K7/logs/docker-cleanup-resume.stderr","stderr_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","stdout":"evidence/K7/logs/docker-cleanup-resume.stdout","stdout_sha256":"6b022a34619a84a954253075a6d235d6e32e2f8aac2ad55eafd3d730c9f4c46f"}
