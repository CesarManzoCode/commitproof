+++ b/go/services/multipooler/internal/manager/pg_replication.go
@@ -601,12 +601,11 @@ func (pm *MultipoolerManager) setSynchronizedStandbySlots(ctx context.Context, c
 	if !pm.slotBasedReplicationEnabled() {
 		return nil
 	}
-	slots, err := pm.followerPhysicalSlotNames(cohort)
-	if err != nil {
-		return err
-	}
+	// CommitProof mutant M5 (standby-slots-cleared): the cohort's physical
+	// slots are not listed; synchronized_standby_slots is always written
+	// empty, so logical decoding no longer waits for the cohort.
 	if err := pm.alterSystemSetOptions(ctx, []postgresOption{
-		{name: "synchronized_standby_slots", value: strings.Join(slots, ",")},
+		{name: "synchronized_standby_slots", value: ""},
 	}); err != nil {
 		return err
 	}
